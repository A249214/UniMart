# =============================================================================
# UniMart — Production Environment Variables Reference
# =============================================================================
# For deployment on Lovable, Netlify, Vercel, or Firebase Hosting:
# Add each variable in your hosting platform's Environment Variables settings.
#
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS OR SERVICE ACCOUNT KEYS.
# Only client-safe public identifiers (VITE_*) belong in frontend web builds.
# =============================================================================

# --- Firebase Web App Configuration ---
# Source: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyA_SAMPLE_PRODUCTION_KEY_1234567
VITE_FIREBASE_AUTH_DOMAIN=unimart-campus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=unimart-campus
VITE_FIREBASE_STORAGE_BUCKET=unimart-campus.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=109283746501
VITE_FIREBASE_APP_ID=1:109283746501:web:98a7b6c5d4e3f210

# --- Cloudinary Media CDN & Upload Preset ---
# Source: Cloudinary Dashboard -> Settings -> Upload -> Upload Presets (Unsigned)
# NOTE: Cloudinary API Secrets MUST NEVER be added to frontend environment variables.
VITE_CLOUDINARY_CLOUD_NAME=unimart-campus
VITE_CLOUDINARY_UPLOAD_PRESET=unimart_unsigned_preset
